\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The noise-driven phase transition.} \textbf  {(a)} Wrong-successor rate of the argmax over signal tokens, restricted to positions whose input token is noise---exactly the positions that require the noise-skipping circuit. The attention-only model matches the analytic \textsf  {ctx-count}{} argmax for $0.2\le \alpha \le 0.7$ and jumps to ${\sim }50\%$ (successor-pair chance level) for $\alpha \ge 0.8$; one FFN restores formation. \textbf  {(b)} Test accuracy normalised by the argmax ceiling $\alpha /2$ (Lemma\nobreakspace  {}\ref  {lem:ceiling}). At $\alpha =0.8$ the attention-only model plateaus at $0.90$ of its ceiling (best of seven seeds); +FFN runs reach the ceiling either immediately or through staged plateaus.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:phase}{{3}{7}{\textbf {The noise-driven phase transition.} \textbf {(a)} Wrong-successor rate of the argmax over signal tokens, restricted to positions whose input token is noise---exactly the positions that require the noise-skipping circuit. The attention-only model matches the analytic \ctxcount {} argmax for $0.2\le \alpha \le 0.7$ and jumps to ${\sim }50\%$ (successor-pair chance level) for $\alpha \ge 0.8$; one FFN restores formation. \textbf {(b)} Test accuracy normalised by the argmax ceiling $\alpha /2$ (Lemma~\ref {lem:ceiling}). At $\alpha =0.8$ the attention-only model plateaus at $0.90$ of its ceiling (best of seven seeds); +FFN runs reach the ceiling either immediately or through staged plateaus}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}The feed-forward layer is a finite-sample Bayesian calibrator}{7}{section.6}\protected@file@percent }
\newlabel{sec:ffn}{{6}{7}{The feed-forward layer is a finite-sample Bayesian calibrator}{section.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The calibration ladder}: excess CE over \textsf  {ideal-$\alpha $}{} of five hand-set readouts on the \emph  {same} frozen $W^{\star }$ attention (bars), against the analytic references and the GD-trained single-FFN model (lines). A softmax readout of the count vector is poorly calibrated at any temperature; a $\qopname  \relax o{log}(\mathrm  {count}+\beta )$ FFN recovers \textsf  {ctx-count}{}; the GELU equalize FFN targets \textsf  {context-Bayes}{} and matches the trained model.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:ffn}{{4}{8}{\textbf {The calibration ladder}: excess CE over \idealalpha {} of five hand-set readouts on the \emph {same} frozen $\Wstar $ attention (bars), against the analytic references and the GD-trained single-FFN model (lines). A softmax readout of the count vector is poorly calibrated at any temperature; a $\log (\mathrm {count}+\beta )$ FFN recovers \ctxcount {}; the GELU equalize FFN targets \ctxbayes {} and matches the trained model}{figure.4}{}}
\newlabel{prop:noaffine}{{2}{8}{No affine readout suffices}{proposition.2}{}}
\newlabel{prop:infinite}{{3}{8}{The gain is finite-sample}{proposition.3}{}}
