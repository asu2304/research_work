\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The noisy Markov ICL task.} Each sequence draws its own transition table over the $V_{\mathrm  {sig}}=10$ signal tokens (right); every signal state has exactly two equiprobable successors. At each step, with probability $\alpha $ a successor of the current state is emitted (blue; the state advances along the orange chain), and with probability $1-\alpha $ a uniform token from the disjoint noise sub-vocabulary is emitted (grey; the state is unchanged). The model must infer the table from context; loss is evaluated on the last $100$ of $T=200$ positions.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:task}{{1}{4}{\textbf {The noisy Markov ICL task.} Each sequence draws its own transition table over the $\Vsig =10$ signal tokens (right); every signal state has exactly two equiprobable successors. At each step, with probability $\alpha $ a successor of the current state is emitted (blue; the state advances along the orange chain), and with probability $1-\alpha $ a uniform token from the disjoint noise sub-vocabulary is emitted (grey; the state is unchanged). The model must infer the table from context; loss is evaluated on the last $100$ of $T=200$ positions}{figure.1}{}}
