\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The predictor hierarchy and trained models} (fresh evaluation data, $5{,}000$ sequences per $\alpha $; CE on positions $100$--$200$). \textbf  {(a)} absolute cross-entropy; \textbf  {(b)} excess CE over the oracle floor \textsf  {ideal-$\alpha $}{}. FFN-augmented models (GD + one FFN, two-cell) track \textsf  {ctx-count}{} and push below it toward \textsf  {context-Bayes}{} at high $\alpha $; the attention-only model carries an additional calibration gap that spikes at the $\alpha =0.8$ phase transition (\S  \ref  {sec:phase}).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:hierarchy}{{2}{5}{\textbf {The predictor hierarchy and trained models} (fresh evaluation data, $5{,}000$ sequences per $\alpha $; CE on positions $100$--$200$). \textbf {(a)} absolute cross-entropy; \textbf {(b)} excess CE over the oracle floor \idealalpha {}. FFN-augmented models (GD + one FFN, two-cell) track \ctxcount {} and push below it toward \ctxbayes {} at high $\alpha $; the attention-only model carries an additional calibration gap that spikes at the $\alpha =0.8$ phase transition (\S \ref {sec:phase})}{figure.2}{}}
