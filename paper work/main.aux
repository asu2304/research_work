\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Separate vs.\ combined attention parametrisation.} \textbf  {(a)} Excess CE at equal (or larger) training budget: the combined $(W_{QK},W_{OV})$ models (dashed, open markers) are consistently worse than their separately-parametrised counterparts, for both attention-only and two-cell models. \textbf  {(b)} Two-cell training at $\alpha =0.5$: the separate parametrisation reaches its ceiling in ${\sim }10$ epochs; the combined one crawls for $100{+}$ and saturates lower.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:comb}{{5}{9}{\textbf {Separate vs.\ combined attention parametrisation.} \textbf {(a)} Excess CE at equal (or larger) training budget: the combined $(\WQK ,\WOV )$ models (dashed, open markers) are consistently worse than their separately-parametrised counterparts, for both attention-only and two-cell models. \textbf {(b)} Two-cell training at $\alpha =0.5$: the separate parametrisation reaches its ceiling in ${\sim }10$ epochs; the combined one crawls for $100{+}$ and saturates lower}{figure.5}{}}
\newlabel{prop:dirichlet}{{4}{9}{No gain without structure}{proposition.4}{}}
