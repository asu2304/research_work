   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "GD trained      pos-pos band (offset 0..5) = [-0.   4.3  1.3  0.1 -0.5 -0.5]   signal perm-asymmetry = 0.085\n",
      "W* hand-coded   pos-pos band (offset 0..5) = [  nan  -20.  -40.  -60.  -80. -100.]   signal perm-asymmetry = nan\n"
     ]
    },
    {
     "data": {
      "image/png": "",
