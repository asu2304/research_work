   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "GD trained      layer-1 peak offset = 1   layer-2 induction mass = 0.729\n",
      "W* hand-coded   layer-1 peak offset = 1   layer-2 induction mass = 0.799\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x800 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Rung 2 (BEHAVIORAL): GD  vs  W*  — do both implement the induction circuit? ─\n",
    "# Top row = GD trained model;  bottom row = W* hand-construction  (same THR).\n",
    "@torch.no_grad()\n",
    "def attentions(model, x, is_ws=False):\n",
    "    \"\"\"Return (A1, A2) softmax attention maps [B,T,T] for either model.\"\"\"\n",
    "    if not is_ws:                                   # DisentangledTransformer returns raw scores\n",
    "        _, (a1, a2) = model(x, return_attn=True)\n",
    "        return F.softmax(a1, -1).cpu().numpy(), F.softmax(a2, -1).cpu().numpy()\n",
    "    B, T = x.shape                                  # W* exposes no attn → replay its forward pass\n",
    "    tok = F.one_hot(x, V).float()\n",
    "    pos = F.one_hot(torch.arange(T, device=x.device), seq_len).float().unsqueeze(0).expand(B, T, -1)\n",
    "    s = torch.cat([tok, pos], -1)\n",
    "    mask = torch.triu(torch.ones(T, T, device=x.device) * float('-inf'), diagonal=1)\n",
    "    As = []\n",
    "    for layer in (model.layer1, model.layer2):\n",
    "        Q, K, Vv = layer.W_q(s), layer.W_k(s), layer.W_v(s)\n",
    "        sc = torch.bmm(Q, K.transpose(1, 2)) / (layer.output_dim ** 0.5) + mask\n",
    "        A = F.softmax(sc, -1); As.append(A.cpu().numpy())\n",
    "        s = torch.cat([s, layer.W_o(torch.bmm(A, Vv))], -1)\n",
    "    return As\n",
    "\n",
    "xb = x_c.numpy()\n",
    "def offset_profile(A1, maxoff=10):                  # layer-1: mean attention vs offset (t-k)\n",
    "    off = np.zeros(maxoff + 1)\n",
    "    for t in range(TOKEN_START, TOKEN_END):\n",
    "        for d in range(maxoff + 1):\n",
    "            if t - d >= 0: off[d] += A1[:, t, t - d].mean()\n",
    "    return off / (TOKEN_END - TOKEN_START)\n",
    "def induction_mass(A2):                             # layer-2: mass on keys whose prev tok == current\n",
    "    m = 0.0; n = 0\n",
    "    for t in range(TOKEN_START, TOKEN_END):\n",
    "        if t < 2: continue\n",
    "        match = (xb[:, 0:t - 1] == xb[:, t:t + 1]).astype(float)\n",
    "        m += (A2[:, t, 1:t] * match).sum(1).mean(); n += 1\n",
    "    return m / n\n",
    "\n",
    "si = 0\n",
    "fig, ax = plt.subplots(2, 3, figsize=(15, 8))\n",
    "for row, (name, model, is_ws, col) in enumerate(\n",
    "        [('GD trained', gd_model, False, 'steelblue'),\n",
    "         ('W* hand-coded', ws_model, True, 'seagreen')]):\n",
    "    A1, A2 = attentions(model, x_c.to(device), is_ws)\n",
    "    off = offset_profile(A1); mass = induction_mass(A2)\n",
    "    print(f'{name:14s}  layer-1 peak offset = {off.argmax()}   layer-2 induction mass = {mass:.3f}')\n",
    "    ax[row, 0].bar(range(len(off)), off, color=col)\n",
    "    ax[row, 0].set_title(f'{name}: L1 attention vs offset (t−k)')\n",
    "    ax[row, 0].set_xlabel('offset d'); ax[row, 0].set_ylabel('mean attention')\n",
    "    ax[row, 1].imshow(A1[si, TOKEN_START:TOKEN_END, TOKEN_START:TOKEN_END], aspect='auto', cmap='viridis')\n",
    "    ax[row, 1].set_title(f'{name}: L1 attention (1 seq)'); ax[row, 1].set_xlabel('key'); ax[row, 1].set_ylabel('query')\n",
    "    ax[row, 2].imshow(A2[si, TOKEN_START:TOKEN_END, :TOKEN_END], aspect='auto', cmap='viridis')\n",
    "    ax[row, 2].set_title(f'{name}: L2 attention (1 seq)'); ax[row, 2].set_xlabel('key'); ax[row, 2].set_ylabel('query')\n",
    "plt.suptitle(f'Induction circuit: GD (top) vs W* (bottom)   |   THR={THR}', y=1.02, fontsize=12)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
