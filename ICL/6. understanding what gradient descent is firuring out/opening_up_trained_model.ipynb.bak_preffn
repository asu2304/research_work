      "Cell \u001b[0;32mIn[5], line 107\u001b[0m\n\u001b[1;32m    105\u001b[0m x, y, seq_len, V, blob \u001b[38;5;241m=\u001b[39m load_data(SPLIT, t)\n\u001b[1;32m    106\u001b[0m yw \u001b[38;5;241m=\u001b[39m y[:, TOKEN_START:TOKEN_END]; Vs \u001b[38;5;241m=\u001b[39m \u001b[38;5;28mint\u001b[39m(blob[\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mvocab_set1\u001b[39m\u001b[38;5;124m'\u001b[39m])\n\u001b[0;32m--> 107\u001b[0m CURVES[\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mgd\u001b[39m\u001b[38;5;124m'\u001b[39m]\u001b[38;5;241m.\u001b[39mappend(res[t][\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mgd\u001b[39m\u001b[38;5;124m'\u001b[39m]); CURVES[\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mctx\u001b[39m\u001b[38;5;124m'\u001b[39m]\u001b[38;5;241m.\u001b[39mappend(res[t][\u001b[38;5;124m'\u001b[39m\u001b[38;5;124malp\u001b[39m\u001b[38;5;124m'\u001b[39m])\n\u001b[1;32m    108\u001b[0m CURVES[\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mideal\u001b[39m\u001b[38;5;124m'\u001b[39m]\u001b[38;5;241m.\u001b[39mappend(res[t][\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mialp\u001b[39m\u001b[38;5;124m'\u001b[39m]); CURVES[\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mwstar\u001b[39m\u001b[38;5;124m'\u001b[39m]\u001b[38;5;241m.\u001b[39mappend(res[t][\u001b[38;5;124m'\u001b[39m\u001b[38;5;124mws\u001b[39m\u001b[38;5;124m'\u001b[39m])\n\u001b[1;32m    109\u001b[0m L \u001b[38;5;241m=\u001b[39m _wlogits(blob)\n",
