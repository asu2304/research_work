       "<Figure size 1200x1000 with 8 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Rung 3 (STRUCTURAL): GD vs W* — gauge-invariant M_QK⁽¹⁾ side by side ───────\n",
    "# Top row = GD;  bottom row = W*.  Note: W* uses hard ±1e9 \"logic gates\"; we mask\n",
    "# those (|x|>1e6 → NaN, shown white) so the meaningful structure is visible, and\n",
    "# give each panel its own robust colour scale (magnitudes are not comparable, the\n",
    "# *pattern* is — that's the gauge/implementation-freedom point).\n",
    "import warnings\n",
    "def MQK(blk):\n",
    "    D = blk.W_q.weight.shape[0]\n",
    "    return (blk.W_q.weight.t() @ blk.W_k.weight / (D ** 0.5)).detach().cpu().numpy()\n",
    "def view(M):\n",
    "    M = M.copy(); M[np.abs(M) > 1e6] = np.nan; return M    # hide hard gates\n",
    "\n",
    "fig, ax = plt.subplots(2, 2, figsize=(12, 10))\n",
    "for row, (name, model) in enumerate([('GD trained', gd_model), ('W* hand-coded', ws_model)]):\n",
    "    mqk = MQK(model.layer1); pp = mqk[V:, V:]\n",
    "    with warnings.catch_warnings():\n",
    "        warnings.simplefilter('ignore')                    # offset-0 diagonal is all-NaN for W*\n",
    "        band = [np.nanmean(np.diagonal(view(pp), offset=-d)) for d in range(6)]\n",
    "    tt = mqk[:V_sig, :V_sig]; nrm = np.linalg.norm(tt)\n",
    "    if nrm > 0:\n",
    "        diag = np.mean(np.diag(tt)); offm = (tt.sum() - np.trace(tt)) / (V_sig * (V_sig - 1))\n",
    "        recon = np.full_like(tt, offm); np.fill_diagonal(recon, diag)\n",
    "        asym = np.linalg.norm(tt - recon) / nrm\n",
    "    else:\n",
    "        asym = float('nan')                                # W*: signal block is identically 0\n",
    "    print(f'{name:14s}  pos-pos band (offset 0..5) = {np.round(band, 1)}   '\n",
    "          f'signal perm-asymmetry = {asym:.3f}')\n",
    "\n",
    "    Mv = view(mqk); q = np.nanpercentile(np.abs(Mv), 99)\n",
    "    im0 = ax[row, 0].imshow(Mv, cmap='RdBu_r', vmin=-q, vmax=q)\n",
    "    ax[row, 0].axhline(V - .5, color='k', lw=.5); ax[row, 0].axvline(V - .5, color='k', lw=.5)\n",
    "    ax[row, 0].set_title(f'{name}: M_QK⁽¹⁾  (token | position)')\n",
    "    ax[row, 0].set_xlabel('key coord'); ax[row, 0].set_ylabel('query coord')\n",
    "    plt.colorbar(im0, ax=ax[row, 0], fraction=.046)\n",
    "\n",
    "    ppv = view(pp)[:40, :40]; q2 = np.nanpercentile(np.abs(ppv), 99)\n",
    "    im1 = ax[row, 1].imshow(ppv, cmap='RdBu_r', vmin=-q2, vmax=q2)\n",
    "    ax[row, 1].set_title(f'{name}: pos-pos block (first 40) — prev-position band')\n",
    "    ax[row, 1].set_xlabel('key position'); ax[row, 1].set_ylabel('query position')\n",
    "    plt.colorbar(im1, ax=ax[row, 1], fraction=.046)\n",
    "plt.suptitle(f'M_QK⁽¹⁾ score geometry: GD (top) vs W* (bottom)   |   THR={THR}', y=1.01, fontsize=12)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
