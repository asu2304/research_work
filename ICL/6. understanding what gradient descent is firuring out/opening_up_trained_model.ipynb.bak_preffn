   "source": [
    "# ── Comparison plot: train vs test side-by-side ───────────────────────────────\n",
    "# Left panel = train split, right panel = test split.  Same four curves each.\n",
    "# (No dropdown — both splits are drawn together, so no duplicate render.)\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "def plot_comparison_both(save=True):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(15, 5), sharey=True)\n",
    "    for ax, split in zip(axes, ('train', 'test')):\n",
    "        res  = results[split]\n",
    "        thrs = sorted(res.keys())\n",
    "        gd_ce   = [res[t]['gd']   for t in thrs]\n",
    "        ws_ce   = [res[t]['ws']   for t in thrs]\n",
    "        alp_ce  = [res[t]['alp']  for t in thrs]\n",
    "        ialp_ce = [res[t]['ialp'] for t in thrs]\n",
    "\n",
    "        ax.plot(thrs, gd_ce,   'o-', color='steelblue',  linewidth=2, label='D=220 trained')\n",
    "        ax.plot(thrs, ws_ce,   's-', color='seagreen',   linewidth=2,\n",
    "                label=f'W* hand-constructed (sigma={WS_SIGMA})')\n",
    "        ax.plot(thrs, alp_ce,  '^-', color='firebrick',  linewidth=2, label='ctx-count')\n",
    "        ax.plot(thrs, ialp_ce, 'v-', color='darkorange', linewidth=2, label='ideal-α')\n",
    "\n",
    "        ax.set_xlabel('Threshold (α)', fontsize=12)\n",
    "        ax.set_title(f'{split} split  (N={N_SEQS})', fontsize=12)\n",
    "        ax.legend(fontsize=9)\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "    axes[0].set_ylabel(f'Cross-Entropy  (tokens {TOKEN_START}–{TOKEN_END})', fontsize=11)\n",
    "    fig.suptitle(\n",
    "        f'D=220 trained vs W* vs baselines  |  window [{TOKEN_START}:{TOKEN_END}]  |  N={N_SEQS}',\n",
    "        fontsize=12, y=1.02\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    if save:\n",
    "        out_path = os.path.join(MODELS_DIR, 'ce_comparison_train_test.png')\n",
    "        plt.savefig(out_path, dpi=150, bbox_inches='tight')\n",
    "        print(f'Saved → {out_path}')\n",
    "    plt.show()\n",
    "\n",
    "plot_comparison_both()\n"
   ]
  },
