     ]
    }
   ],
   "source": [
    "# ══ ALL-IN-ONE CE comparison (single plot) ════════════════════════════════════\n",
    "# Self-contained: depends ONLY on the SETTINGS cell (results, thresholds, classes,\n",
    "# load_data, device, ...).  Safe to delete the 3 separate plot cells\n",
    "# (W*-better / L1-head / freeze-readout) — this also re-exports SPLIT/better_par/\n",
    "# WBETTER_PAR so the downstream KL & split-by-target cells keep working.\n",
    "# ── EDIT HERE ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "SPLIT      = 'test'                                          # 'test' or 'train'\n",
    "SIG_LIST   = [3.0, 3.0, 4.0, 4.5, 5.0, 5.0, 6.0, 6.0, 6.0]   # W*-better σ per α\n",
    "BN_LIST    = [3.0, 2.0, 2.0, 1.5, 1.5, 1.0, 1.0, 0.5, -0.5]  # W*-better noise-bias per α\n",
    "L1_PAR     = {0.1:(1e-2,3e-1), 0.2:(1e-2,3e-1), 0.3:(1e-2,3e-1),   # L1-head floor (b_sig,\n",
    "              0.4:(3e-3,1e-1), 0.5:(3e-3,1e-1), 0.6:(3e-3,1e-1),   # b_noise) per α —\n",
    "              0.7:(1e-3,3e-2), 0.8:(1e-3,3e-2), 0.9:(1e-3,1e-2)}   # grid-optimal, no search\n",
    "FREEZE_TAG = 'freeze_readout'                                # freeze-model file tag\n",
    "FREEZE_EPS = 1e-6\n",
    "MLP_TAG    = 'mlp'                                           # MLP-model tag (train_with_mlp.py)\n",
    "SHOW = dict(ideal=True, ctx=True, gd=True, wstar=False,\n",
    "            wbetter=True, l1=False, freeze=False, mlp=False)    # toggle any curve off\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "import os, json as _json\n",
    "import numpy as np, torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "_thrs = sorted(thresholds)\n",
    "assert len(SIG_LIST) == len(BN_LIST) == len(_thrs), f'lists must be length {len(_thrs)}'\n",
    "_par = {t: (float(SIG_LIST[i]), float(BN_LIST[i])) for i, t in enumerate(_thrs)}\n",
    "\n",
    "# W* built once (weights identical across thresholds)\n",
    "_x0, _y0, _sl0, _V0, _bl0 = load_data(SPLIT, _thrs[0])\n",
    "_WSm = PerfectInductionTransformer(_V0, _sl0, int(_bl0['vocab_set1'])).to(device).eval()\n",
    "\n",
    "@torch.no_grad()\n",
    "def _wlogits(blob):\n",
    "    return _WSm(blob['x'].to(device))[:, TOKEN_START:TOKEN_END].cpu()\n",
    "\n",
    "def _ce_logits(L, y):                       # softmax CE from raw logits\n",
    "    return F.cross_entropy(L.reshape(-1, L.shape[-1]), y.reshape(-1)).item()\n",
    "\n",
    "def _l1_ce(L, yw, V, Vs, bsig, bnoise):     # (freq+b)/Σ with the given per-class floor\n",
    "    f = L.clamp_min(0.0)\n",
    "    b = torch.zeros(V); b[:Vs] = bsig; b[Vs:] = bnoise\n",
    "    p = f + b; p = p / p.sum(-1, keepdim=True)\n",
    "    fl = p.reshape(-1, V).clamp_min(1e-12)\n",
    "    return (-torch.log(fl[torch.arange(fl.shape[0]), yw.reshape(-1)])).mean().item()\n",
    "\n",
    "def _freeze_ce(thr, seq_len, V):            # divide-by-sum CE of the trained freeze model\n",
    "    mp = os.path.join(MODELS_DIR, f'model_{FREEZE_TAG}_x_{thr}.pth')\n",
    "    if not os.path.exists(mp): return None\n",
    "    cfgp = os.path.join(MODELS_DIR, f'metrics_{FREEZE_TAG}_x_{thr}.json')\n",
    "    ad = ATTN_DIM\n",
    "    if os.path.exists(cfgp):\n",
    "        ad = int(_json.load(open(cfgp)).get('config', {}).get('attn_dim', ATTN_DIM))\n",
    "    m = DisentangledTransformer(V, seq_len, ad, bias=True).to(device)\n",
    "    m.load_state_dict(torch.load(mp, map_location=device, weights_only=True)); m.eval()\n",
    "    x, y, _, _, _ = load_data(SPLIT, thr)\n",
    "    with torch.no_grad():\n",
    "        out = m(x.to(device))[:, TOKEN_START:TOKEN_END]\n",
    "        p = (out + FREEZE_EPS) / (out.sum(-1, keepdim=True) + V * FREEZE_EPS)\n",
    "        yw = y[:, TOKEN_START:TOKEN_END].to(device)\n",
    "        ce = F.nll_loss(torch.log(p).reshape(-1, V), yw.reshape(-1)).item()\n",
    "    del m\n",
    "    if device.type == 'cuda': torch.cuda.empty_cache()\n",
    "    return ce\n",
    "\n",
    "# minimal-MLP model (matches train_with_mlp.py); standard softmax CE\n",
    "class _DTMLP(nn.Module):\n",
    "    def __init__(self, V, T, ad, mh, bias=True, act='gelu'):\n",
    "        super().__init__()\n",
    "        self.total_vocab=V; self.seq_len=T; self.attn_dim=ad; self.initial_dim=V+T\n",
    "        self.layer1=ConcatAttentionBlock(self.initial_dim, ad)\n",
    "        self.layer2=ConcatAttentionBlock(self.initial_dim+ad, ad)\n",
    "        D=self.initial_dim+2*ad\n",
    "        self.ff1=nn.Linear(D, mh); self.ff2=nn.Linear(mh, D)\n",
    "        self.act=nn.GELU() if act=='gelu' else nn.ReLU()\n",
    "        self.fc_out=nn.Linear(D, V, bias=bias)\n",
    "    def forward(self, x):\n",
    "        B,T=x.shape\n",
    "        tok=F.one_hot(x, self.total_vocab).float()\n",
    "        pos=F.one_hot(torch.arange(T, device=x.device), self.seq_len).float().unsqueeze(0).expand(B,T,-1)\n",
    "        s=torch.cat([tok,pos],-1)\n",
    "        mm=torch.triu(torch.ones(T,T,device=x.device)*float('-inf'),1)\n",
    "        s,_=self.layer1(s,mm); s,_=self.layer2(s,mm)\n",
    "        s=s+self.ff2(self.act(self.ff1(s)))\n",
    "        return self.fc_out(s)\n",
    "\n",
    "def _mlp_ce(thr, seq_len, V):               # standard softmax CE of the trained MLP model\n",
    "    mp = os.path.join(MODELS_DIR, f'model_{MLP_TAG}_x_{thr}.pth')\n",
    "    if not os.path.exists(mp): return None\n",
    "    cfgp = os.path.join(MODELS_DIR, f'metrics_{MLP_TAG}_x_{thr}.json'); ad=ATTN_DIM; mh=128; act='gelu'\n",
    "    if os.path.exists(cfgp):\n",
    "        cfg=_json.load(open(cfgp)).get('config', {}); ad=int(cfg.get('attn_dim',ATTN_DIM)); mh=int(cfg.get('mlp_hidden',128)); act=cfg.get('mlp_act','gelu')\n",
    "    m = _DTMLP(V, seq_len, ad, mh, bias=True, act=act).to(device)\n",
    "    m.load_state_dict(torch.load(mp, map_location=device, weights_only=True)); m.eval()\n",
    "    x, y, _, _, _ = load_data(SPLIT, thr)\n",
    "    ce = compute_ce(m, x, y, V)             # SETTINGS helper: softmax CE on the window\n",
    "    del m\n",
    "    if device.type == 'cuda': torch.cuda.empty_cache()\n",
    "    return ce\n",
    "\n",
    "# ── collect every curve ───────────────────────────────────────────────────────\n",
    "res = results[SPLIT]\n",
    "CURVES = {k: [] for k in ('gd', 'ctx', 'ideal', 'wstar', 'wbetter', 'l1', 'freeze', 'mlp')}\n",
    "for t in _thrs:\n",
    "    x, y, seq_len, V, blob = load_data(SPLIT, t)\n",
    "    yw = y[:, TOKEN_START:TOKEN_END]; Vs = int(blob['vocab_set1'])\n",
    "    CURVES['gd'].append(res[t]['gd']); CURVES['ctx'].append(res[t]['alp'])\n",
    "    CURVES['ideal'].append(res[t]['ialp']); CURVES['wstar'].append(res[t]['ws'])\n",
    "    L = _wlogits(blob)\n",
    "    nmask = torch.zeros(V); nmask[Vs:] = 1.0\n",
    "    sig, bn = _par[t]\n",
    "    CURVES['wbetter'].append(_ce_logits(L * sig + nmask * bn, yw))\n",
    "    _bs, _bn = L1_PAR.get(round(t, 1), (1e-3, 1e-1))\n",
    "    CURVES['l1'].append(_l1_ce(L, yw, V, Vs, _bs, _bn))\n",
    "    CURVES['freeze'].append(_freeze_ce(t, seq_len, V))\n",
    "    CURVES['mlp'].append(_mlp_ce(t, seq_len, V))\n",
    "\n",
    "# ── one plot ──────────────────────────────────────────────────────────────────\n",
    "SPECS = [('ideal',   'ideal-α (Bayes floor)',     'v-', 'darkorange', 2.5, 8),\n",
    "         ('ctx',     'ctx-count',                 '^-', 'firebrick',  2.5, 8),\n",
    "         ('gd',      'GD trained (softmax)',      'o-', 'steelblue',  2.0, 8),\n",
    "         ('wstar',   f'W* hand (σ={WS_SIGMA})',   's-', 'seagreen',   2.0, 8),\n",
    "         ('wbetter', 'W*-better (per-α σ,bN)',    'D-', 'purple',     2.3, 8),\n",
    "         ('l1',      'L1 head (freq, best-fit b)','P-', 'crimson',    2.0, 8),\n",
    "         ('freeze',  'GD freeze-readout (+bias)', '*-', 'magenta',    2.3, 13),\n",
    "         ('mlp',     'GD + minimal MLP',          'X-', 'black',      2.3, 9)]\n",
    "fig, ax = plt.subplots(figsize=(11, 6.5))\n",
    "for key, label, style, color, lw, ms in SPECS:\n",
    "    if not SHOW.get(key): continue\n",
    "    ys = CURVES[key]\n",
    "    xs = [t for t, v in zip(_thrs, ys) if v is not None]\n",
    "    yv = [v for v in ys if v is not None]\n",
    "    if not yv: continue\n",
    "    ax.plot(xs, yv, style, color=color, lw=lw, ms=ms, label=label)\n",
    "ax.set_xlabel('threshold (α)', fontsize=12)\n",
    "ax.set_ylabel(f'Cross-Entropy (tokens {TOKEN_START}–{TOKEN_END})', fontsize=11)\n",
    "ax.set_title(f'All predictors  |  {SPLIT} split  |  N={N_SEQS}', fontsize=12)\n",
    "ax.legend(fontsize=9, ncol=2); ax.grid(True, alpha=0.3); plt.tight_layout()\n",
    "_out = os.path.join(MODELS_DIR, f'ce_all_{SPLIT}.png'); plt.savefig(_out, dpi=150)\n",
    "plt.show(); print('Saved →', _out)\n",
    "\n",
    "# ── numeric table ─────────────────────────────────────────────────────────────\n",
    "cols = [s for s in SPECS if SHOW.get(s[0])]\n",
    "print('α    ' + ''.join(f'{lbl.split()[0]:>11}' for _, lbl, *_ in cols))\n",
    "for i, t in enumerate(_thrs):\n",
    "    vals = ''.join(f'{(CURVES[k][i] if CURVES[k][i] is not None else float(\"nan\")):>11.4f}'\n",
    "                   for k, *_ in cols)\n",
    "    print(f'{t:<5}{vals}')\n",
    "\n",
    "# keep downstream cells (KL / split-by-target) working after deleting old cells:\n",
    "WBETTER_PAR = dict(_par); better_par = dict(_par)\n"
   ]
  },
