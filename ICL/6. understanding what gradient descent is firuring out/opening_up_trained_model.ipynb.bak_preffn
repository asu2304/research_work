   "source": [
    "\n",
    "# ══ PER-POSITION PROBABILITY DIAGNOSTIC — every predictor at one focus token ════\n",
    "# Token strip + ground-truth Markov chain + a P(token|context) bar chart for EACH\n",
    "# predictor at FOCUS_POS:  ideal-α, ctx-count, W*, W*-better, L1-head, GD-softmax,\n",
    "# GD freeze-readout(+bias), GD+MLP.  Self-contained (uses SETTINGS-cell objects).\n",
    "\n",
    "# ── EDIT HERE ─────────────────────────────────────────────────────────────────\n",
    "INSPECT_THRESH = 0.6\n",
    "INSPECT_SPLIT  = 'test'        # 'test' or 'train'\n",
    "SEQ_IDX        = 0             # which sequence in the split\n",
    "RANGE_START    = 150           # first printed position (None → T-50)\n",
    "RANGE_END      = 200           # last printed position, exclusive (None → T)\n",
    "FOCUS_POS      = 160           # position for the bar charts (None → RANGE_END-1)\n",
    "INSPECT_SIGMA  = WS_SIGMA      # W* temperature for the plain-W* bar\n",
    "FREEZE_EPS_I   = 1e-6\n",
    "STRIP_MODEL    = 'mlp'         # whose argmax is shown in the token strip/table\n",
    "SHOW_INSPECT   = dict(ideal=True, ctx=True, wstar=True, wbetter=True, l1=True,\n",
    "                      gd=True, freeze=True, mlp=True)\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "import os, json as _json\n",
    "import numpy as np, torch\n",
    "import torch.nn as nn, torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "class _DTMLP(nn.Module):                        # matches train_with_mlp.py\n",
    "    def __init__(self, V, T, ad, mh, bias=True, act='gelu'):\n",
    "        super().__init__()\n",
    "        self.total_vocab=V; self.seq_len=T; self.attn_dim=ad; self.initial_dim=V+T\n",
    "        self.layer1=ConcatAttentionBlock(self.initial_dim, ad)\n",
    "        self.layer2=ConcatAttentionBlock(self.initial_dim+ad, ad)\n",
    "        D=self.initial_dim+2*ad\n",
    "        self.ff1=nn.Linear(D, mh); self.ff2=nn.Linear(mh, D)\n",
    "        self.act=nn.GELU() if act=='gelu' else nn.ReLU()\n",
    "        self.fc_out=nn.Linear(D, V, bias=bias)\n",
    "    def forward(self, x):\n",
    "        B,T=x.shape\n",
    "        tok=F.one_hot(x, self.total_vocab).float()\n",
    "        pos=F.one_hot(torch.arange(T, device=x.device), self.seq_len).float().unsqueeze(0).expand(B,T,-1)\n",
    "        s2=torch.cat([tok,pos],-1)\n",
    "        mm=torch.triu(torch.ones(T,T,device=x.device)*float('-inf'),1)\n",
    "        s2,_=self.layer1(s2,mm); s2,_=self.layer2(s2,mm)\n",
    "        s2=s2+self.ff2(self.act(self.ff1(s2)))\n",
    "        return self.fc_out(s2)\n",
    "\n",
    "def _inspect():\n",
    "    thr = INSPECT_THRESH\n",
    "    xs, ys, T, V, bl = load_data(INSPECT_SPLIT, thr, n_cap=max(N_SEQS, SEQ_IDX+1))\n",
    "    V_sig = int(bl['vocab_set1'])\n",
    "    assert 0 <= SEQ_IDX < xs.shape[0], f'SEQ_IDX out of range (have {xs.shape[0]})'\n",
    "    x_seq = xs[SEQ_IDX]; y_seq = ys[SEQ_IDX]; ta = bl['transitions'][SEQ_IDX]\n",
    "    x_np = x_seq.numpy(); y_np = y_seq.numpy()\n",
    "    xb = x_seq.unsqueeze(0).to(device)\n",
    "\n",
    "    rs = max(0, T-50) if RANGE_START is None else max(0, int(RANGE_START))\n",
    "    re = T if RANGE_END is None else min(T, int(RANGE_END))\n",
    "    fp = (re-1) if FOCUS_POS is None else int(FOCUS_POS)\n",
    "    assert 0 <= rs < re <= T and 0 <= fp < T\n",
    "\n",
    "    # last-ruled (governing state) at every position\n",
    "    lr_arr = np.full(T, -1); cur=-1\n",
    "    for t in range(T):\n",
    "        if x_np[t] < V_sig: cur=int(x_np[t])\n",
    "        lr_arr[t]=cur\n",
    "\n",
    "    # ── W* (built once) → frequency logits ──────────────────────────────────\n",
    "    wstar = PerfectInductionTransformer(V, T, V_sig).to(device).eval()\n",
    "    with torch.no_grad(): ws_logits = wstar(xb)[0]                 # [T,V], =freq vec (>=0)\n",
    "    ws_p = F.softmax(ws_logits*INSPECT_SIGMA, -1).cpu().numpy()\n",
    "\n",
    "    nmask = torch.zeros(V, device=device); nmask[V_sig:]=1.0\n",
    "    sig_wb, bn_wb = (WBETTER_PAR.get(round(thr,1),(INSPECT_SIGMA,0.0))\n",
    "                     if 'WBETTER_PAR' in globals() else (INSPECT_SIGMA,0.0))\n",
    "    wb_p = F.softmax(ws_logits*float(sig_wb)+nmask*float(bn_wb), -1).cpu().numpy()\n",
    "\n",
    "    bs_l1, bn_l1 = (L1_PAR.get(round(thr,1),(1e-3,1e-1)) if 'L1_PAR' in globals() else (1e-3,1e-1))\n",
    "    bvec = torch.zeros(V, device=device); bvec[:V_sig]=bs_l1; bvec[V_sig:]=bn_l1\n",
    "    l1f = ws_logits.clamp_min(0.0)+bvec; l1_p = (l1f/l1f.sum(-1,keepdim=True)).cpu().numpy()\n",
    "\n",
    "    # ── trained models (load attn_dim from each metrics file) ───────────────\n",
    "    def _meta(tag):\n",
    "        f = (f'metrics_x_{thr}.json' if tag=='' else f'metrics_{tag}_x_{thr}.json')\n",
    "        p = os.path.join(MODELS_DIR, f)\n",
    "        return _json.load(open(p)).get('config',{}) if os.path.exists(p) else {}\n",
    "    def _load(tag, mlp=False):\n",
    "        fn = (f'model_x_{thr}.pth' if tag=='' else f'model_{tag}_x_{thr}.pth')\n",
    "        mp = os.path.join(MODELS_DIR, fn)\n",
    "        if not os.path.exists(mp): return None\n",
    "        c=_meta(tag); ad=int(c.get('attn_dim',ATTN_DIM))\n",
    "        if mlp: m=_DTMLP(V,T,ad,int(c.get('mlp_hidden',128)),bias=True,act=c.get('mlp_act','gelu')).to(device)\n",
    "        else:   m=DisentangledTransformer(V,T,ad,bias=True).to(device)\n",
    "        m.load_state_dict(torch.load(mp,map_location=device,weights_only=True)); m.eval(); return m\n",
    "\n",
    "    gd_p=fr_p=ml_p=None\n",
    "    m=_load('')\n",
    "    if m is not None:\n",
    "        with torch.no_grad(): gd_p=F.softmax(m(xb)[0],-1).cpu().numpy()\n",
    "        del m\n",
    "    m=_load('freeze_readout')\n",
    "    if m is not None:\n",
    "        with torch.no_grad(): o=m(xb)[0]; fr_p=((o+FREEZE_EPS_I)/(o.sum(-1,keepdim=True)+V*FREEZE_EPS_I)).cpu().numpy()\n",
    "        del m\n",
    "    m=_load('mlp', mlp=True)\n",
    "    if m is not None:\n",
    "        with torch.no_grad(): ml_p=F.softmax(m(xb)[0],-1).cpu().numpy()\n",
    "        del m\n",
    "    if device.type=='cuda': torch.cuda.empty_cache()\n",
    "\n",
    "    # ── ctx-count and ideal-α full [T,V] ────────────────────────────────────\n",
    "    ctx_p=np.zeros((T,V)); tc=np.zeros((V,V_sig)); pend=np.zeros(V); lr=-1; eps=0.01\n",
    "    ideal_p=np.zeros((T,V))\n",
    "    for t in range(T):\n",
    "        xt=int(x_np[t])\n",
    "        if xt<V_sig: tc[:,xt]+=pend; pend[:]=0; pend[xt]=1; lr=xt\n",
    "        else:        pend[xt]+=1\n",
    "        q = xt if xt<V_sig else max(lr,0)\n",
    "        cs=tc[q]+eps; ts=cs.sum()\n",
    "        p=np.zeros(V); p[:V_sig]=cs/ts*thr; p[V_sig:]=(1-thr)/(V-V_sig); ctx_p[t]=p\n",
    "        st=lr_arr[t]; pi=np.zeros(V); pi[V_sig:]=(1-thr)/(V-V_sig)\n",
    "        if st>=0: pi[int(ta[st][0])]+=thr/2; pi[int(ta[st][1])]+=thr/2\n",
    "        else:     pi[:V_sig]+=thr/V_sig\n",
    "        ideal_p[t]=pi\n",
    "\n",
    "    # ── assemble predictor panels ───────────────────────────────────────────\n",
    "    ALL=[('ideal','ideal-α (oracle)',ideal_p,'darkorange'),\n",
    "         ('ctx','ctx-count',ctx_p,'firebrick'),\n",
    "         ('wstar',f'W* (σ={INSPECT_SIGMA})',ws_p,'seagreen'),\n",
    "         ('wbetter',f'W*-better (σ={sig_wb:.1f}, bN={bn_wb:+.1f})',wb_p,'purple'),\n",
    "         ('l1','L1 head (freq, floor b)',l1_p,'crimson')]\n",
    "    if gd_p is not None: ALL.append(('gd','GD trained (softmax)',gd_p,'steelblue'))\n",
    "    if fr_p is not None: ALL.append(('freeze','GD freeze-readout (+bias)',fr_p,'magenta'))\n",
    "    if ml_p is not None: ALL.append(('mlp','GD + MLP',ml_p,'black'))\n",
    "    PRED=[p for p in ALL if SHOW_INSPECT.get(p[0],True)]\n",
    "    PMAP={k:(lbl,arr,col) for k,lbl,arr,col in PRED}\n",
    "\n",
    "    state_fp=int(lr_arr[fp])\n",
    "    exp = (int(ta[state_fp][0]),int(ta[state_fp][1])) if state_fp>=0 else None\n",
    "\n",
    "    # ── printout: Markov chain + table ──────────────────────────────────────\n",
    "    print(f\"Sequence {SEQ_IDX} | {INSPECT_SPLIT} | α={thr} | positions [{rs},{re}) | T={T}\")\n",
    "    print(\"Markov chain (this sequence):\")\n",
    "    for r in range(V_sig):\n",
    "        print(f\"   {r} -> {{{int(ta[r][0])}, {int(ta[r][1])}}}\")\n",
    "    strip_key = STRIP_MODEL if STRIP_MODEL in PMAP else PRED[-1][0]\n",
    "    strip_arr = PMAP[strip_key][1]; strip_pred = strip_arr.argmax(-1)\n",
    "    print(f\"\\nTable shows '{strip_key}' argmax.  pos | x[t] | y[t] | pred | ok | p(y[t]) | governing-state -> {{succ}}\")\n",
    "    print(f\"  {'pos':>4} {'x':>4} {'y':>4} {'pred':>4} {'ok':>3} {'p(y)':>8}  state->succ\")\n",
    "    for t in range(rs, re):\n",
    "        ok='Y' if strip_pred[t]==y_np[t] else '.'\n",
    "        st=int(lr_arr[t]); succ=f\"{st}->{{{int(ta[st][0])},{int(ta[st][1])}}}\" if st>=0 else \"(none)\"\n",
    "        mk=' <-FP' if t==fp else ''\n",
    "        print(f\"  {t:>4} {int(x_np[t]):>4} {int(y_np[t]):>4} {int(strip_pred[t]):>4} {ok:>3} {strip_arr[t,y_np[t]]:8.4f}  {succ}{mk}\")\n",
    "    nc=int((strip_pred[rs:re]==y_np[rs:re]).sum())\n",
    "    print(f\"\\n  '{strip_key}' acc on range: {nc}/{re-rs} = {nc/(re-rs):.1%}\")\n",
    "    print(f\"  x[{fp}]={int(x_np[fp])}  governing state={state_fp}  Markov-valid next={exp}  target y[{fp}]={int(y_np[fp])}\")\n",
    "\n",
    "    # ── figure: strip + one bar per predictor ───────────────────────────────\n",
    "    BLUE='#1f6feb'; ORANGE='#e07a18'; GRAY='#bfc4cb'; RED='#d62828'; GREEN='#2a9d4a'\n",
    "    n=len(PRED); cols=re-rs\n",
    "    fig=plt.figure(figsize=(max(11,cols*0.22), 3.2+2.2*n))\n",
    "    gs=fig.add_gridspec(1+n,1,height_ratios=[1.3]+[2.0]*n, hspace=0.7)\n",
    "    ax=fig.add_subplot(gs[0])\n",
    "    for j,t in enumerate(range(rs,re)):\n",
    "        ax.text(j,2,str(int(x_np[t])),ha='center',va='center',fontsize=7,color=(BLUE if x_np[t]<V_sig else GRAY))\n",
    "        ax.text(j,1,str(int(y_np[t])),ha='center',va='center',fontsize=7,color=(BLUE if y_np[t]<V_sig else GRAY))\n",
    "        ax.text(j,0,str(int(strip_pred[t])),ha='center',va='center',fontsize=7,\n",
    "                color=(BLUE if strip_pred[t]==y_np[t] else RED),\n",
    "                fontweight=('bold' if strip_pred[t]==y_np[t] else 'normal'))\n",
    "    if rs<=fp<re: ax.axvspan(fp-rs-0.5,fp-rs+0.5,color=ORANGE,alpha=0.15,zorder=0)\n",
    "    ax.set_yticks([0,1,2]); ax.set_yticklabels([f'{strip_key} pred','y[t]','x[t]'],fontsize=8)\n",
    "    ax.set_xticks(range(0,cols,max(1,cols//12))); ax.set_xticklabels([str(rs+i) for i in range(0,cols,max(1,cols//12))],fontsize=7)\n",
    "    ax.set_xlim(-0.5,cols-0.5); ax.set_ylim(-0.6,2.6)\n",
    "    ax.set_title(f\"seq {SEQ_IDX}, positions [{rs},{re})  (blue=signal, gray=noise, red={strip_key} wrong)\",fontsize=10)\n",
    "    for sp in ['top','right']: ax.spines[sp].set_visible(False)\n",
    "\n",
    "    chain = f\"x[{fp}]={int(x_np[fp])}, state {state_fp} -> expect {{{exp[0]}, {exp[1]}}}\" if exp else f\"x[{fp}]={int(x_np[fp])} (no state)\"\n",
    "    for r,(key,lbl,arr,col) in enumerate(PRED):\n",
    "        axb=fig.add_subplot(gs[1+r]); p1=arr[fp]\n",
    "        bc=[BLUE if k<V_sig else GRAY for k in range(V)]\n",
    "        if exp:\n",
    "            for k in exp: bc[k]=GREEN\n",
    "        axb.bar(range(V),p1,color=bc,edgecolor='white',linewidth=0.6)\n",
    "        axb.axvline(int(y_np[fp]),color=ORANGE,lw=1.2,ls='--',label=f'target y={int(y_np[fp])}')\n",
    "        axb.axvline(int(arr[fp].argmax()),color=RED,lw=1.2,ls=':',label=f'argmax={int(arr[fp].argmax())}')\n",
    "        if exp: axb.plot([],[],'s',color=GREEN,markersize=8,label=f'Markov-valid {{{exp[0]},{exp[1]}}}')\n",
    "        axb.set_xticks(range(V)); axb.set_ylabel('P(tok|ctx)',fontsize=8)\n",
    "        axb.set_xlabel('token id (0-9 signal, 10-19 noise)',fontsize=8)\n",
    "        axb.legend(fontsize=7,loc='upper right'); axb.grid(axis='y',alpha=0.3)\n",
    "        axb.set_title(f\"{lbl}   at t={fp}   {chain}   p(y)={p1[int(y_np[fp])]:.3f}\",fontsize=9,color=col)\n",
    "        for sp in ['top','right']: axb.spines[sp].set_visible(False)\n",
    "    plt.tight_layout()\n",
    "    out=os.path.join(MODELS_DIR, f\"inspect_all_seq{SEQ_IDX}_thr{thr}_fp{fp}.png\")\n",
    "    plt.savefig(out,dpi=150); plt.show(); print(f\"\\nSaved -> {out}\")\n",
    "\n",
    "_inspect()\n"
   ]
