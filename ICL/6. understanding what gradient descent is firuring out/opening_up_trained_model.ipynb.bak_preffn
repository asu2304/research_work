      "\u001b[0;31mRuntimeError\u001b[0m: Error(s) in loading state_dict for DisentangledTransformer:\n\tsize mismatch for layer1.W_q.weight: copying a param with shape torch.Size([220, 220]) from checkpoint, the shape in current model is torch.Size([500, 220]).\n\tsize mismatch for layer1.W_k.weight: copying a param with shape torch.Size([220, 220]) from checkpoint, the shape in current model is torch.Size([500, 220]).\n\tsize mismatch for layer1.W_v.weight: copying a param with shape torch.Size([220, 220]) from checkpoint, the shape in current model is torch.Size([500, 220]).\n\tsize mismatch for layer1.W_o.weight: copying a param with shape torch.Size([220, 220]) from checkpoint, the shape in current model is torch.Size([500, 500]).\n\tsize mismatch for layer2.W_q.weight: copying a param with shape torch.Size([220, 440]) from checkpoint, the shape in current model is torch.Size([500, 720]).\n\tsize mismatch for layer2.W_k.weight: copying a param with shape torch.Size([220, 440]) from checkpoint, the shape in current model is torch.Size([500, 720]).\n\tsize mismatch for layer2.W_v.weight: copying a param with shape torch.Size([220, 440]) from checkpoint, the shape in current model is torch.Size([500, 720]).\n\tsize mismatch for layer2.W_o.weight: copying a param with shape torch.Size([220, 220]) from checkpoint, the shape in current model is torch.Size([500, 500]).\n\tsize mismatch for fc_out.weight: copying a param with shape torch.Size([20, 660]) from checkpoint, the shape in current model is torch.Size([20, 1220])."
     ]
    }
   ],
   "source": [
    "# ══ CE split by TARGET type:  all | noise targets | ruled(signal) targets ══════\n",
    "# Toggle any curve on/off with SHOW_SPLIT.  Uses SPLIT + WBETTER_PAR (the σ/bN\n",
    "# lists) exported by the all-in-one cell above.  Left = CE over all window tokens;\n",
    "# middle/right = same per-token CE averaged only over noise (y≥V_sig) / ruled (y<V_sig).\n",
    "# ── EDIT HERE ─────────────────────────────────────────────────────────────────\n",
    "_SPLIT     = SPLIT if 'SPLIT' in globals() else 'test'\n",
    "SHOW_SPLIT = dict(gd=True, wstar=True, wbetter=True, ctx=True, ideal=True,\n",
    "                  l1=False, freeze=True, mlp=True)  # which curves to include\n",
    "FREEZE_TAG = globals().get('FREEZE_TAG', 'freeze_readout')\n",
    "FREEZE_EPS = 1e-6\n",
    "MLP_TAG    = globals().get('MLP_TAG', 'mlp')\n",
    "_L1_PAR    = globals().get('L1_PAR', {0.1:(1e-2,3e-1),0.2:(1e-2,3e-1),0.3:(1e-2,3e-1),\n",
    "             0.4:(3e-3,1e-1),0.5:(3e-3,1e-1),0.6:(3e-3,1e-1),0.7:(1e-3,3e-2),\n",
    "             0.8:(1e-3,3e-2),0.9:(1e-3,1e-2)})   # L1-head floor per α (grid-optimal)\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "import os, json as _json\n",
    "import numpy as np, torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def _ctx_probs(blob, alpha, eps=0.01):\n",
    "    x = blob['x'].numpy(); V = int(blob['total_vocab']); Vs = int(blob['vocab_set1']); nn_ = V - Vs; B = x.shape[0]\n",
    "    tc = np.zeros((B, V, Vs)); pend = np.zeros((B, V)); lr = np.full(B, -1, np.int64)\n",
    "    def st(c):\n",
    "        cc = x[:, c]; r = cc < Vs; ri = np.where(r)[0]\n",
    "        if len(ri):\n",
    "            rt = cc[ri]; oh = (np.arange(Vs) == rt[:, None]).astype(float)\n",
    "            np.add.at(tc, ri, pend[ri, :, None] * oh[:, None, :]); pend[ri, :] = 0; pend[ri, rt] = 1; lr[ri] = rt\n",
    "        ni = np.where(~r)[0]\n",
    "        if len(ni): pend[ni, cc[ni]] += 1\n",
    "    for i in range(TOKEN_START): st(i)\n",
    "    W = TOKEN_END - TOKEN_START; out = np.zeros((B, W, V))\n",
    "    for j, t in enumerate(range(TOKEN_START, TOKEN_END)):\n",
    "        v = x[:, t]; qq = np.where(v < Vs, v, np.maximum(lr, 0)); cs = tc[np.arange(B), qq] + eps; ts = cs.sum(1, keepdims=True)\n",
    "        p = np.zeros((B, V)); p[:, :Vs] = cs / ts * alpha; p[:, Vs:] = (1 - alpha) / nn_; out[:, j, :] = np.maximum(p, 1e-12); st(t)\n",
    "    return out\n",
    "def _ideal_probs(blob, alpha):\n",
    "    x = blob['x'].numpy(); tr = blob['transitions']; V = int(blob['total_vocab']); Vs = int(blob['vocab_set1']); nn_ = V - Vs; B = x.shape[0]\n",
    "    ta = np.array([[tr[b][v] for v in range(Vs)] for b in range(B)], dtype=np.int64)\n",
    "    W = TOKEN_END - TOKEN_START; out = np.zeros((B, W, V)); ls = np.zeros(B, np.int64)\n",
    "    for t in range(TOKEN_END):\n",
    "        iss = x[:, t] < Vs; ls = np.where(iss, x[:, t], ls)\n",
    "        if t < TOKEN_START: continue\n",
    "        s0 = ta[np.arange(B), ls, 0]; s1 = ta[np.arange(B), ls, 1]\n",
    "        p = np.zeros((B, V)); p[:, Vs:] = (1 - alpha) / nn_; p[np.arange(B), s0] += alpha / 2; p[np.arange(B), s1] += alpha / 2\n",
    "        out[:, t - TOKEN_START, :] = np.maximum(p, 1e-12)\n",
    "    return out\n",
    "def _nll_logits(L, y): B, W, V = L.shape; return F.cross_entropy(L.reshape(-1, V), y.reshape(-1), reduction='none').reshape(B, W).numpy()\n",
    "def _nll_probs(p, y):  B, W, V = p.shape; return -np.log(np.clip(p[np.arange(B)[:, None], np.arange(W)[None, :], y], 1e-12, 1))\n",
    "\n",
    "def _l1_pertoken(L, yw, V, Vs, bsig, bnoise):  # (freq+b)/Σ per-token nll with given floor\n",
    "    f = L.clamp_min(0.0)\n",
    "    b = torch.zeros(V); b[:Vs] = bsig; b[Vs:] = bnoise\n",
    "    p = (f + b); p = (p / p.sum(-1, keepdim=True)).numpy()\n",
    "    B, W, _ = p.shape\n",
    "    return -np.log(np.clip(p[np.arange(B)[:, None], np.arange(W)[None, :], yw.numpy()], 1e-12, 1))\n",
    "def _freeze_pertoken(thr, sl, V, xte, yw):     # divide-by-sum prob of the trained freeze model\n",
    "    mp = os.path.join(MODELS_DIR, f'model_{FREEZE_TAG}_x_{thr}.pth')\n",
    "    if not os.path.exists(mp): return None\n",
    "    cfgp = os.path.join(MODELS_DIR, f'metrics_{FREEZE_TAG}_x_{thr}.json'); ad = ATTN_DIM\n",
    "    if os.path.exists(cfgp): ad = int(_json.load(open(cfgp)).get('config', {}).get('attn_dim', ATTN_DIM))\n",
    "    m = DisentangledTransformer(V, sl, ad, bias=True).to(device)\n",
    "    m.load_state_dict(torch.load(mp, map_location=device, weights_only=True)); m.eval()\n",
    "    with torch.no_grad(): out = m(xte.to(device))[:, TOKEN_START:TOKEN_END].cpu()\n",
    "    del m\n",
    "    if device.type == 'cuda': torch.cuda.empty_cache()\n",
    "    p = ((out + FREEZE_EPS) / (out.sum(-1, keepdim=True) + V * FREEZE_EPS)).numpy()\n",
    "    B, W, _ = p.shape\n",
    "    return -np.log(np.clip(p[np.arange(B)[:, None], np.arange(W)[None, :], yw.numpy()], 1e-12, 1))\n",
    "\n",
    "class _DTMLP(nn.Module):                        # matches train_with_mlp.py\n",
    "    def __init__(self, V, T, ad, mh, bias=True, act='gelu'):\n",
    "        super().__init__()\n",
    "        self.total_vocab=V; self.seq_len=T; self.attn_dim=ad; self.initial_dim=V+T\n",
    "        self.layer1=ConcatAttentionBlock(self.initial_dim, ad)\n",
    "        self.layer2=ConcatAttentionBlock(self.initial_dim+ad, ad)\n",
    "        D=self.initial_dim+2*ad\n",
    "        self.ff1=nn.Linear(D, mh); self.ff2=nn.Linear(mh, D)\n",
    "        self.act=nn.GELU() if act=='gelu' else nn.ReLU()\n",
    "        self.fc_out=nn.Linear(D, V, bias=bias)\n",
    "    def forward(self, x):\n",
    "        B,T=x.shape\n",
    "        tok=F.one_hot(x, self.total_vocab).float()\n",
    "        pos=F.one_hot(torch.arange(T, device=x.device), self.seq_len).float().unsqueeze(0).expand(B,T,-1)\n",
    "        s2=torch.cat([tok,pos],-1)\n",
    "        mm=torch.triu(torch.ones(T,T,device=x.device)*float('-inf'),1)\n",
    "        s2,_=self.layer1(s2,mm); s2,_=self.layer2(s2,mm)\n",
    "        s2=s2+self.ff2(self.act(self.ff1(s2)))\n",
    "        return self.fc_out(s2)\n",
    "\n",
    "def _mlp_pertoken(thr, sl, V, xte, yw):        # per-token softmax NLL of the trained MLP model\n",
    "    mp=os.path.join(MODELS_DIR, f'model_{MLP_TAG}_x_{thr}.pth')\n",
    "    if not os.path.exists(mp): return None\n",
    "    cfgp=os.path.join(MODELS_DIR, f'metrics_{MLP_TAG}_x_{thr}.json'); ad=ATTN_DIM; mh=128; act='gelu'\n",
    "    if os.path.exists(cfgp):\n",
    "        cfg=_json.load(open(cfgp)).get('config',{}); ad=int(cfg.get('attn_dim',ATTN_DIM)); mh=int(cfg.get('mlp_hidden',128)); act=cfg.get('mlp_act','gelu')\n",
    "    m=_DTMLP(V, sl, ad, mh, bias=True, act=act).to(device)\n",
    "    m.load_state_dict(torch.load(mp,map_location=device,weights_only=True)); m.eval()\n",
    "    with torch.no_grad(): L=m(xte.to(device))[:, TOKEN_START:TOKEN_END].cpu()\n",
    "    del m\n",
    "    if device.type=='cuda': torch.cuda.empty_cache()\n",
    "    return _nll_logits(L, yw)\n",
    "\n",
    "SPECS  = [('gd', 'GD trained', 'steelblue'), ('wstar', f'W* (σ={WS_SIGMA})', 'seagreen'),\n",
    "          ('wbetter', 'W*-better', 'purple'), ('l1', 'L1 head', 'crimson'),\n",
    "          ('freeze', 'GD freeze-readout (+bias)', 'magenta'), ('ctx', 'ctx-count', 'firebrick'),\n",
    "          ('ideal', 'ideal-α', 'darkorange'), ('mlp', 'GD + MLP', 'black')]\n",
    "active   = [s for s in SPECS if SHOW_SPLIT.get(s[0])]\n",
    "need_ws  = any(k in {'wstar', 'wbetter', 'l1'} for k, _, _ in active)\n",
    "agg = {k: {'all': [], 'noise': [], 'ruled': []} for k, _, _ in active}\n",
    "\n",
    "for thr in thresholds:\n",
    "    xte, yte, sl, V, bl = load_data(_SPLIT, thr, n_cap=N_SEQS); Vs = int(bl['vocab_set1'])\n",
    "    yw = yte[:, TOKEN_START:TOKEN_END]; ynp = yw.numpy(); noise = ynp >= Vs; ruled = ~noise\n",
    "    nmask = torch.zeros(V); nmask[Vs:] = 1.0\n",
    "    Lgd = Lws = None\n",
    "    if SHOW_SPLIT.get('gd'):\n",
    "        gd = load_model(thr, sl, V)\n",
    "        with torch.no_grad(): Lgd = gd(xte.to(device))[:, TOKEN_START:TOKEN_END].cpu()\n",
    "        del gd\n",
    "    if need_ws:\n",
    "        ws = _WS if '_WS' in globals() else PerfectInductionTransformer(V, sl, Vs).to(device).eval()\n",
    "        with torch.no_grad(): Lws = ws(xte.to(device))[:, TOKEN_START:TOKEN_END].cpu()\n",
    "    per = {}\n",
    "    if SHOW_SPLIT.get('gd'):    per['gd']    = _nll_logits(Lgd, yw)\n",
    "    if SHOW_SPLIT.get('wstar'): per['wstar'] = _nll_logits(Lws * WS_SIGMA, yw)\n",
    "    if SHOW_SPLIT.get('wbetter'):\n",
    "        if 'WBETTER_PAR' in globals() and thr in WBETTER_PAR:   sig, bN = WBETTER_PAR[thr]\n",
    "        elif 'better_par' in globals() and thr in better_par:   sig, bN = better_par[thr]\n",
    "        else:                                                   sig, bN = WS_SIGMA, 0.0\n",
    "        per['wbetter'] = _nll_logits(Lws * float(sig) + nmask * float(bN), yw)\n",
    "    if SHOW_SPLIT.get('l1'):\n",
    "        _bs, _bn = _L1_PAR.get(round(thr, 1), (1e-3, 1e-1)); per['l1'] = _l1_pertoken(Lws, yw, V, Vs, _bs, _bn)\n",
    "    if SHOW_SPLIT.get('freeze'): per['freeze'] = _freeze_pertoken(thr, sl, V, xte, yw)\n",
    "    if SHOW_SPLIT.get('ctx'):    per['ctx']    = _nll_probs(_ctx_probs(bl, thr), ynp)\n",
    "    if SHOW_SPLIT.get('ideal'):  per['ideal']  = _nll_probs(_ideal_probs(bl, thr), ynp)\n",
    "    if SHOW_SPLIT.get('mlp'):    per['mlp']    = _mlp_pertoken(thr, sl, V, xte, yw)\n",
    "    for key, _, _ in active:\n",
    "        nll = per.get(key)\n",
    "        if nll is None:\n",
    "            for s in ('all', 'noise', 'ruled'): agg[key][s].append(float('nan'))\n",
    "        else:\n",
    "            agg[key]['all'].append(float(nll.mean()))\n",
    "            agg[key]['noise'].append(float(nll[noise].mean()) if noise.any() else float('nan'))\n",
    "            agg[key]['ruled'].append(float(nll[ruled].mean()) if ruled.any() else float('nan'))\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(18, 5), sharex=True)\n",
    "for col, (key_sub, title) in enumerate([('all', 'All tokens'),\n",
    "                                        ('noise', 'Noise targets  (y ≥ V_sig)'),\n",
    "                                        ('ruled', 'Ruled / signal targets  (y < V_sig)')]):\n",
    "    for key, label, color in active:\n",
    "        ys = agg[key][key_sub]\n",
    "        if all(np.isnan(v) for v in ys): continue\n",
    "        ax[col].plot(thresholds, ys, 'o-', color=color, lw=2, label=label)\n",
    "    ax[col].set_title(f'CE — {title}'); ax[col].set_xlabel('threshold (α)'); ax[col].grid(alpha=.3)\n",
    "ax[0].set_ylabel(f'Cross-Entropy  (tokens {TOKEN_START}–{TOKEN_END})'); ax[0].legend(fontsize=8)\n",
    "plt.suptitle(f'Cross-entropy split by target-token type  |  {_SPLIT} split', y=1.02, fontsize=13)\n",
    "plt.tight_layout(); plt.savefig(os.path.join(MODELS_DIR, f'ce_split_by_target_{_SPLIT}.png'), dpi=150); plt.show()\n"
   ]
  },
