    "N_STEPS   = None          # None = every step to the end; e.g. 98 for just the first epoch\n",
    "STRIDE    = 1\n",
    "FPS       = 15\n",
    "ANIM_DPI  = 100\n",
    "\n",
    "def big_animation(t, kind=WHICH_GRAD):\n",
    "    n = SNAP[t][0].shape[0] if N_STEPS is None else min(N_STEPS + 1, SNAP[t][0].shape[0])\n",
    "    rows = list(range(0, n, STRIDE))\n",
    "    if rows[-1] != n - 1:\n",
    "        rows.append(n - 1)\n",
    "    st = SMETA[t]['step']\n",
    "    h = MET[t]['history']\n",
    "\n",
    "    W1 = np.asarray(SNAP[t][0][:n], dtype=np.float32)\n",
    "    W2 = np.asarray(SNAP[t][1][:n], dtype=np.float32)\n",
    "    G1 = np.asarray(GRAD[t][kind][0][:n], dtype=np.float32)\n",
    "    G2 = np.asarray(GRAD[t][kind][1][:n], dtype=np.float32)\n",
    "    vW1, vW2 = float(np.abs(W1).max()) or 1.0, float(np.abs(W2).max()) or 1.0\n",
    "\n",
    "    wn1 = np.linalg.norm(W1.reshape(n, -1), axis=1)\n",
    "    wn2 = np.linalg.norm(W2.reshape(n, -1), axis=1)\n",
    "    gn1 = np.linalg.norm(G1.reshape(n, -1), axis=1)\n",
    "    gn2 = np.linalg.norm(G2.reshape(n, -1), axis=1)\n",
    "\n",
    "    fig = plt.figure(figsize=(20, 17))\n",
    "    gs = fig.add_gridspec(3, 2, height_ratios=[3.1, 3.1, 1.25], hspace=0.16, wspace=0.08)\n",
    "    axW1, axW2 = fig.add_subplot(gs[0, 0]), fig.add_subplot(gs[0, 1])\n",
    "    axG1, axG2 = fig.add_subplot(gs[1, 0]), fig.add_subplot(gs[1, 1])\n",
    "    axL, axN = fig.add_subplot(gs[2, 0]), fig.add_subplot(gs[2, 1])\n",
    "\n",
    "    def nrm(v):\n",
