    "        ax.set_title(f'{title}\\n|max| {np.abs(A).max():.4g}    '\n",
    "                     f'||.||_F {np.linalg.norm(A):.4g}', fontsize=13)\n",
    "\n",
    "    def draw(fi):\n",
