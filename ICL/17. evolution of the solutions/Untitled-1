    "## 1. Recomputing the gradients\n",
    "\n",
    "`minibatch` replays the exact batch order: seed, build the model on the device, `apply_init`,\n",
    "`install_fixed`, then iterate the DataLoader — the same sequence the training script uses, so the\n",
    "RNG lands in the same state and batch $s$ is the batch that actually produced step $s{+}1$.\n",
    "Row $s$ of the cache is $\\nabla\\mathcal{L}_{\\text{batch }s}(W(s))$: the direction Adam was handed\n",
    "at that step.\n",
    "\n",
    "Cached to `artifacts/<cell>/gstep_{mb,full}{1,2}_x_{alpha}.npy`; re-runs are a no-op. The\n",
    "minibatch pass is seconds, the full-batch pass a few minutes.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c81716a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "GRAD_DEVICE = 'cuda:3'\n",
    "WHICH_GRAD  = 'minibatch'      # 'minibatch' (what Adam saw) | 'full' (whole train set)\n",
    "DO_FULL     = True             # also compute the full-batch gradient for the norm comparison\n",
    "\n",
    "def gpath(t, kind, li):\n",
    "    return os.path.join(ADIR, f'gstep_{kind}{li}_x_{t}.npy')\n",
    "\n",
    "def batch_order(M, thr, device):\n",
    "    '''Replay the DataLoader index sequence, epoch by epoch, from the same RNG state.'''\n",
    "    torch.manual_seed(0); np.random.seed(0)\n",
    "    blob = M.load_data('train', thr)\n",
    "    x, y = blob['x'], blob['y']\n",
    "    m = M.QKOnlyTransformer(V, M.CFG['seq_len'], V + M.CFG['seq_len'],\n",
    "                            M.CFG['v_sig'], thr).to(device)\n",
    "    M.apply_init(m, 0); M.install_fixed(m)\n",
    "    loader = torch.utils.data.DataLoader(\n",
    "        torch.utils.data.TensorDataset(x, y), batch_size=M.CFG['batch_size'], shuffle=True)\n",
    "    order = []\n",
    "    for _ in range(M.CFG['epochs']):\n",
    "        order += [list(b) for b in loader._index_sampler]\n",
    "    return m, x, y, order\n",
    "\n",
    "def compute_step_grads(t, kind):\n",
    "    p1, p2 = gpath(t, kind, 1), gpath(t, kind, 2)\n",
    "    nrow = SNAP[t][0].shape[0]\n",
    "    if os.path.exists(p1) and os.path.exists(p2) and \\\n",
    "            np.load(p1, mmap_mode='r').shape[0] == nrow:\n",
    "        print(f'alpha={t} [{kind}]: cached')\n",
    "        return\n",
    "    dev = torch.device(GRAD_DEVICE if torch.cuda.is_available() else 'cpu')\n",
    "    m, x, y, order = batch_order(IN, t, dev)\n",
    "    ps = IN.qk_params(m)\n",
    "    m.eval()\n",
    "    ts, te = IN.CFG['token_start'], IN.CFG['seq_len']\n",
    "    G1 = np.lib.format.open_memmap(p1, mode='w+', dtype=np.float32,\n",
    "                                   shape=(nrow,) + SNAP[t][0].shape[1:])\n",
    "    G2 = np.lib.format.open_memmap(p2, mode='w+', dtype=np.float32,\n",
    "                                   shape=(nrow,) + SNAP[t][1].shape[1:])\n",
    "    t0 = time.time()\n",
    "    for s in range(nrow):\n",
    "        with torch.no_grad():\n",
    "            m.layer1.W_qk.copy_(torch.from_numpy(np.asarray(SNAP[t][0][s])).to(dev))\n",
    "            m.layer2.W_qk.copy_(torch.from_numpy(np.asarray(SNAP[t][1][s])).to(dev))\n",
    "        for pp in ps:\n",
    "            pp.grad = None\n",
    "        if kind == 'minibatch':\n",
    "            idx = order[min(s, len(order) - 1)]\n",
    "            xb = x[idx].to(dev); yb = y[idx][:, ts:te].to(dev)\n",
    "            F.cross_entropy(m(xb)[:, ts:te].reshape(-1, V), yb.reshape(-1)).backward()\n",
    "        else:\n",
    "            n = x.shape[0]; ntok = n * (te - ts)\n",
    "            for i in range(0, n, 512):\n",
    "                xb = x[i:i + 512].to(dev); yb = y[i:i + 512, ts:te].to(dev)\n",
    "                (F.cross_entropy(m(xb)[:, ts:te].reshape(-1, V), yb.reshape(-1),\n",
    "                                 reduction='sum') / ntok).backward()\n",
    "        G1[s] = ps[0].grad.detach().cpu().numpy()\n",
    "        G2[s] = ps[1].grad.detach().cpu().numpy()\n",
    "        if s % 100 == 0:\n",
    "            G1.flush(); G2.flush()\n",
    "            el = time.time() - t0\n",
    "            print(f'  alpha={t} [{kind}] {s}/{nrow}  {el:.0f}s  '\n",
    "                  f'ETA {el/max(s,1)*(nrow-s):.0f}s', flush=True)\n",
    "    G1.flush(); G2.flush()\n",
    "    print(f'alpha={t} [{kind}]: {nrow} rows in {(time.time()-t0)/60:.1f}m')\n",
    "\n",
    "GRAD = {}\n",
    "for t in THRS:\n",
    "    compute_step_grads(t, 'minibatch')\n",
    "    if DO_FULL:\n",
    "        compute_step_grads(t, 'full')\n",
    "    GRAD[t] = {k: [np.load(gpath(t, k, 1), mmap_mode='r'), np.load(gpath(t, k, 2), mmap_mode='r')]\n",
    "               for k in (['minibatch', 'full'] if DO_FULL else ['minibatch'])}\n",
    "print('\\ngradient caches ready:', {t: list(GRAD[t]) for t in THRS})\n"
   ]
